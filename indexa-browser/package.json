{
  "name": "indexa-browser",
  "version": "1.3.0",
  "description": "Indexa Browser",
  "main": "main.js",
  "author": "Indexa",
  "scripts": {
    "cfg": "node scripts/make-config.js",
    "start": "node scripts/make-config.js && electron .",
    "dist": "node scripts/make-config.js && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "app.indexa.browser",
    "productName": "Indexa Browser",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "IndexaBrowser.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT"
}